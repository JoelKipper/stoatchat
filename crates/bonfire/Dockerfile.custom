# Custom build: only compiles the bonfire crate (and its transitive deps),
# not the whole monorepo - upstream's Dockerfile assumes a prebuilt
# ghcr.io/stoatchat/base image with every service already compiled, which
# doesn't exist for this fork. Mirrors crates/delta/Dockerfile.custom.
FROM rust:1.92.0-slim-trixie AS builder
WORKDIR /home/rust/src

# See crates/delta/Dockerfile.custom for why this is capped.
ARG CARGO_BUILD_JOBS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    make pkg-config libssl-dev libdav1d-dev

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build -j "${CARGO_BUILD_JOBS}" --locked --release -p revolt-bonfire

FROM debian:13 AS debian

FROM gcr.io/distroless/cc-debian13:nonroot
COPY --from=builder /home/rust/src/target/release/revolt-bonfire ./
COPY --from=debian /usr/bin/uname /usr/bin/uname

EXPOSE 14703
USER nonroot
CMD ["./revolt-bonfire"]
