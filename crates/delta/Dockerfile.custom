# Custom build: only compiles the delta crate (and its transitive deps),
# not the whole monorepo - upstream's Dockerfile assumes a prebuilt
# ghcr.io/stoatchat/base image with every service already compiled, which
# doesn't exist for this fork. Mirrors crates/services/gifbox/Dockerfile.custom.
FROM rust:1.92.0-slim-trixie AS builder
WORKDIR /home/rust/src

# revolt-delta is the biggest crate in the workspace; a release+LTO build
# with the default 4 parallel codegen jobs OOMs this host (7.5GB RAM). Cap
# it low here rather than relying on the caller to pass --build-arg.
ARG CARGO_BUILD_JOBS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    make pkg-config libssl-dev libdav1d-dev

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build -j "${CARGO_BUILD_JOBS}" --locked --release -p revolt-delta

FROM debian:13 AS debian

FROM gcr.io/distroless/cc-debian13:nonroot
COPY --from=builder /home/rust/src/target/release/revolt-delta ./
COPY --from=debian /usr/bin/uname /usr/bin/uname

EXPOSE 14702
ENV ROCKET_ADDRESS=0.0.0.0
USER nonroot
CMD ["./revolt-delta"]
